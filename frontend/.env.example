# Browser calls the Render backend directly — must use NEXT_PUBLIC_ (not a secret; mark as Config in Vercel).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public site origin for sitemap.xml, robots.txt, and Open Graph (no trailing slash).
# Production example: https://myshelflib.com
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used as a fallback when this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth client ID — prefer GOOGLE_CLIENT_ID (server env on Vercel; same name as backend).
# Legacy NEXT_PUBLIC_GOOGLE_CLIENT_ID still works locally.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Telegram Login Widget — prefer TELEGRAM_BOT_USERNAME (server env on Vercel; not a secret).
# Same value as backend TELEGRAM_BOT_USERNAME (no @). Register the host with BotFather (/setdomain).
TELEGRAM_BOT_USERNAME=ShelfStudyBot
# Legacy NEXT_PUBLIC_TELEGRAM_BOT_USERNAME still works.
# Optional comma-separated hosts; when unset, every host may load the widget.
# NEXT_PUBLIC_TELEGRAM_LOGIN_HOSTS=myshelflib.com,localhost

# Product analytics (vendor-agnostic). Leave unset to disable.
# NEXT_PUBLIC_ANALYTICS_VENDOR="posthog"
# Project API key from PostHog → Project settings → Project API key (starts with phc_).
# Do NOT use a Personal API key (phx_ / REST key) — the browser SDK returns 401.
# When set, Shelf sends product events + client errors (api_request_failed, component_error, chunk_load_failed, JS exceptions).
# NEXT_PUBLIC_ANALYTICS_KEY="phc_…"
# NEXT_PUBLIC_ANALYTICS_HOST="https://us.i.posthog.com"
# Legacy PostHog names still work: NEXT_PUBLIC_POSTHOG_KEY / NEXT_PUBLIC_POSTHOG_HOST
