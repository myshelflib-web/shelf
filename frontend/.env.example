# Browser calls the Render backend directly — must use NEXT_PUBLIC_ (not a secret; mark as Config in Vercel).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public site origin for sitemap.xml, robots.txt, and Open Graph (no trailing slash).
# Production example: https://myshelflib.com
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used as a fallback when this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth client ID — prefer GOOGLE_CLIENT_ID (server env on Vercel; same name as backend).
# Legacy NEXT_PUBLIC_GOOGLE_CLIENT_ID still works locally.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Telegram Login Widget — same bot username as backend TELEGRAM_BOT_USERNAME (no @).
# Register the site host with BotFather: /setdomain → your production hostname.
# Optional: comma-separated hosts that may show the widget (defaults to NEXT_PUBLIC_SITE_URL hostname).
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=ShelfStudyBot
# NEXT_PUBLIC_TELEGRAM_LOGIN_HOSTS=myshelflib.com,localhost
