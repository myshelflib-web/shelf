{
  "name": "shelf-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor native shell for Shelf (loads hosted Next.js app)",
  "scripts": {
    "adb-reverse": "sh scripts/adb-reverse.sh",
    "sync": "npx cap sync",
    "ios": "npx cap run ios",
    "android": "sh scripts/adb-reverse.sh && SHELF_MOBILE_URL=${SHELF_MOBILE_URL:-http://localhost:3000} npx cap run android",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "typescript": "^5.7.2"
  }
}
