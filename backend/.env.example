DATABASE_URL="postgresql://upsc:upsc_secret@localhost:5432/upsc_learning"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# --- Local dev (MinIO) ---
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="upsc-docs"
S3_REGION="us-east-1"
# Optional: host the browser uses for presigned PUT/GET (defaults to S3_ENDPOINT)
# S3_PUBLIC_ENDPOINT="http://localhost:9000"

# --- Production (Cloudflare R2) — uncomment and fill on Render ---
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY="<32-char R2 Access Key ID>"
# S3_SECRET_KEY="<64-char R2 Secret Access Key>"
# S3_BUCKET="upsc-docs"
# S3_REGION="auto"

# Public API URL for blog media links in emails/responses (defaults to request host)
# API_PUBLIC_URL=https://api.yourdomain.com
# Public app URL for email links and logo (defaults to first CORS_ORIGIN)
# APP_URL=https://your-app.vercel.app

# Resend (transactional email). In dev without these, OTP codes are logged to the backend console.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Shelf <noreply@yourdomain.com>"
# Optional alias for EMAIL_FROM:
# RESEND_FROM_EMAIL="Shelf <noreply@yourdomain.com>"
# Optional hosted logo URL (skips CID attachment). Leave unset to embed Shelf icon via Resend.
# EMAIL_LOGO_URL="https://your-app.vercel.app/icons/favicon-192.png"

INTERNAL_SECRET="change-me-internal-secret"

# Observability — debug | info | warn | error
LOG_LEVEL="info"
SERVICE_NAME="backend"

# Grafana Cloud Application Observability (OpenTelemetry OTLP). Leave unset to disable.
# From Grafana Cloud → Connections → OpenTelemetry (or Application Observability setup).
# OTEL_SERVICE_NAME="shelf-backend"
# OTEL_DEPLOYMENT_ENVIRONMENT="production"
# OTEL_EXPORTER_OTLP_ENDPOINT="https://otlp-gateway-prod-REGION.grafana.net/otlp"
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic%20BASE64(instanceId:token)"

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# Optional: verify subscription.charged / cancelled events
# RAZORPAY_WEBHOOK_SECRET="whsec_..."
SUBSCRIPTION_AMOUNT_PAISE=99900
SUBSCRIPTION_DAYS=365
# Recurring UPI Autopay list prices (create Razorpay plans on first use, or set IDs)
SUBSCRIPTION_MONTHLY_AMOUNT_PAISE=9900
SUBSCRIPTION_YEARLY_AMOUNT_PAISE=99900
# RAZORPAY_PLAN_MONTHLY_ID="plan_..."
# RAZORPAY_PLAN_YEARLY_ID="plan_..."
# Affiliate: 1000 = 10% of paid amount credited as coins (paise)
AFFILIATE_COMMISSION_BPS=1000
AFFILIATE_ATTRIBUTION_DAYS=30

# Telegram — Login Widget + bot PDF ingest (optional).
# Create a bot with @BotFather, then /setdomain to your app host for the widget.
# TELEGRAM_BOT_TOKEN="123456:ABC..."
# TELEGRAM_BOT_USERNAME="ShelfStudyBot"
# Secret token sent as X-Telegram-Bot-Api-Secret-Token (set the same when calling setWebhook).
# TELEGRAM_WEBHOOK_SECRET="long-random-string"
# Webhook URL: POST {API}/api/telegram/webhook

# Study AI — Gemini (see src/services/shelfGeminiModels.ts, apiKeyRoute.ts)
#
# Same Google key works for chat + embeddings — set LLM_API_KEY only.
# Free Shelf users → LLM_API_KEY_FREE (separate unbilled project).
# Premium users → LLM_API_KEY (billed project).
#
# LLM_API_KEY="AQ…"              # paid — Premium / admin
# LLM_API_KEY_FREE="AIza…"       # free — Free plan users (required)
# (Do not set EMBEDDING_API_KEY unless you need a different key than LLM_API_KEY)
#
# LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# LLM_MODEL="gemini-flash-lite-latest"
# LLM_MODEL_FALLBACKS="gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.5-flash,gemini-3.6-flash"
# Paid tier — raise chat RPM (Lite 15, Flash 5 per model in console):
# GEMINI_CHAT_RPM="800"
# FREE_LLM_TOKENS="50000"
# PREMIUM_LLM_TOKENS="1000000"
# LLM_MAX_OUTPUT_TOKENS="1024"
#
# Study AI depth modes (Quick / Standard / Think longer):
# LLM_MODEL_FAST="gemini-flash-lite-latest"
# LLM_MODEL_STANDARD="gemini-flash-latest"
# LLM_MODEL_DEEP="gemini-flash-latest"   # default; opt-in pinned: gemini-3.7-flash
# LLM_MODEL_MAP="gemini-flash-lite-latest"
# LLM_MAX_OUTPUT_TOKENS_STANDARD="4096"
# LLM_MAX_OUTPUT_TOKENS_DEEP="8192"
# PAGE_ASK_CONTEXT_BUDGET_STANDARD="8000"
# PAGE_ASK_CONTEXT_BUDGET_DEEP="12000"
# LIBRARY_CONTEXT_BUDGET_STANDARD="16000"
# LIBRARY_CONTEXT_BUDGET_DEEP="24000"
#
# Optional Google web search (Custom Search JSON API — does not use Gemini RPM):
# Create a Programmable Search Engine at https://programmablesearchengine.google.com
# and enable the Custom Search API. Then:
# GOOGLE_CSE_ID="your-search-engine-cx"
# GOOGLE_SEARCH_API_KEY="AIza..."
#
# Chat memory: free 30 messages/thread, premium 300 (override with env).
# FREE_CHAT_MESSAGES="30"
# PREMIUM_CHAT_MESSAGES="300"
#
# --- Alt: Groq (chat) + Jina (embeddings — free, OpenAI-compatible) ---
# LLM_API_KEY="gsk_..."
# LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_MODEL="llama-3.1-8b-instant"
# Get free key: https://jina.ai/?sui=apikey
# EMBEDDING_API_KEY="jina_..."
# EMBEDDING_BASE_URL="https://api.jina.ai/v1"
# EMBEDDING_MODEL="jina-embeddings-v3"
#
# --- Gemini embeddings (inherits LLM_API_KEY / LLM_API_KEY_FREE when unset) ---
# EMBEDDING_MODEL="gemini-embedding-001"
# EMBEDDING_DIMENSIONS="768"
# GEMINI_EMBED_RPM="2500"
# GEMINI_EMBED_BATCH="8"
# GEMINI_EMBED_PAUSE_MS="500"
# # Or OpenAI embeddings:
# # EMBEDDING_API_KEY="sk-..."
# # EMBEDDING_BASE_URL="https://api.openai.com/v1"
# # EMBEDDING_MODEL="text-embedding-3-small"
#
# --- Local docker (Qdrant + Ollama) ---
# Start: docker compose up -d && docker compose --profile ai up -d
# Pull models once: docker exec shelf-ollama ollama pull llama3.2:1b && docker exec shelf-ollama ollama pull nomic-embed-text
# VECTOR_DB_URL="http://localhost:6333"
# LLM_API_KEY="ollama"
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_MODEL="llama3.2:1b"
# EMBEDDING_MODEL="nomic-embed-text"
#
# --- OpenAI only (chat + embeddings) ---
# LLM_API_KEY="sk-..."
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL="gpt-4o-mini"
# EMBEDDING_MODEL="text-embedding-3-small"

# Vector DB for Study AI retrieval. Leave unset to use keyword fallback.
#
# --- Option A: Neon pgvector (same Postgres as DATABASE_URL — no Qdrant needed) ---
# 1. Neon dashboard → your project → Extensions → enable "vector"
# 2. Run migrations: cd backend && npx prisma migrate deploy
# VECTOR_DB_PROVIDER="pgvector"
# (Do not set VECTOR_DB_URL for pgvector — vectors live in DATABASE_URL Postgres.)
#
# --- Option B: Qdrant (local docker or Qdrant Cloud) ---
# Local docker: VECTOR_DB_URL="http://localhost:6333" (see root docker-compose.yml)
# VECTOR_DB_PROVIDER="qdrant"
# VECTOR_DB_URL="https://YOUR-CLUSTER.qdrant.io:6333"
# VECTOR_DB_API_KEY=""
# VECTOR_DB_COLLECTION="shelf-library"
# Background PDF indexing for search (uses Gemini embed quota — competes with Standard/Deep Study AI).
# Set false on free tier if embeds rate-limit; Quick Study AI does not need vectors.
# VECTOR_INDEX_WORKER="true"
# VECTOR_INDEX_WORKER_INTERVAL_MS="120000"
# VECTOR_INDEX_START_DELAY_MS="120000"
# VECTOR_INDEX_BATCH_SIZE="1"
# VECTOR_INDEX_PAGE_PAUSE_MS="3000"
# VECTOR_INDEX_PAGE_TIMEOUT_MS="180000"
# VECTOR_INDEX_BATCH_TIMEOUT_MS="300000"
# VECTOR_INDEX_STUCK_MS="360000"
# VECTOR_INDEX_PAGE_ATTEMPTS="3"
# VECTOR_INDEX_LEASE_MS="900000"
# VECTOR_INDEX_PDF_PAGES="40"
# VECTOR_INDEX_PDF_CHARS="80000"
# VECTOR_INDEX_PDF_RANGE_MAX="2097152"
# VECTOR_INDEX_PDF_MAX_BYTES="67108864"
# VECTOR_INDEX_OCR_PAGES="12"
# PDF_OCR="true"
# PDF_OCR_JPEG_MAX_BYTES="1572864"
# PDF_OCR_TIMEOUT_MS="45000"
# VECTOR_DB_TIMEOUT_MS="20000"
# EMBEDDING_TIMEOUT_MS="45000"
# FREE_VECTOR_CHUNKS="500"
# PREMIUM_VECTOR_CHUNKS="10000"
# MAX_CHUNKS_PER_PAGE="40"

# Free plan: 250 MB uploads, 50k Study AI tokens/month, 500 indexed chunks, 30 chat messages/thread.
# Paid plan: 1 GB uploads, 1M tokens/month, 10k indexed chunks, 300 chat messages/thread.
