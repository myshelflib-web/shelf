generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String?
  googleId              String?   @unique
  /** Telegram user id (numeric string). Used for Login Widget + bot PDF ingest. */
  telegramId            String?   @unique
  telegramUsername      String?
  telegramLinkedAt      DateTime?
  /** One-time bot deep-link code (`/start <code>`), max ~32 chars for Telegram. */
  telegramLinkCode      String?   @unique
  telegramLinkExpiresAt DateTime?
  name                  String
  avatarUrl             String?
  role                  Role      @default(STUDENT)
  plan                  Plan      @default(FREE)
  subscriptionExpiresAt DateTime?
  /** Affiliate reward balance in paise (100 = ₹1). Applied at checkout. */
  coinBalance           Int       @default(0)
  studyGoal             StudyGoal @default(GENERAL)
  storageUsedBytes      BigInt    @default(0)
  llmTokensUsed         Int       @default(0)
  llmTokensResetAt      DateTime?
  /** UTC calendar day (YYYY-MM-DD) for daily Study AI cap. */
  llmTokensDailyUsed    Int       @default(0)
  llmTokensDailyDate    String?
  vectorChunksUsed      Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  highlights              Highlight[]
  pageVectorIndexes       PageVectorIndex[]
  progress                UserProgress[]
  starredTopics           StarredArticle[]
  payments                Payment[]
  userSubjects            UserSubject[]
  userFolders             UserFolder[]
  userTopics              UserTopic[]
  studyTasks              StudyTask[]
  chatThreads             ChatThread[]
  relevancyDocs           StudyRelevancyDoc[]
  quizzes                 Quiz[]
  blogPosts               BlogPost[]
  affiliateProfile        AffiliateProfile?
  affiliateEarnings       AffiliateEarning[]  @relation("AffiliateEarner")
  referredEarnings        AffiliateEarning[]  @relation("ReferredUser")
  couponRedemptions       CouponRedemption[]
  recurringSubscriptions  RecurringSubscription[]
  pageSharesOwned         PageShare[]         @relation("PageShareOwner")
  pageSharesReceived      PageShare[]         @relation("PageShareGrantee")
}

enum Plan {
  FREE
  PREMIUM
}

enum StudyGoal {
  GENERAL
  UPSC
  STATE_PCS
  JUDICIARY
  CA
  NEET_PG
  GATE
}

enum Role {
  STUDENT
  ADMIN
}

enum EmailOtpPurpose {
  SIGNUP
  PASSWORD_RESET
}

model EmailOtp {
  id        String          @id @default(uuid())
  email     String
  codeHash  String
  purpose   EmailOtpPurpose
  expiresAt DateTime
  attempts  Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([email, purpose])
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id             String         @id @default(uuid())
  slug           String         @unique
  title          String
  description    String
  excerpt        String
  tags           String[]
  readingMinutes Int            @default(5)
  status         BlogPostStatus @default(DRAFT)
  coverImageKey  String?
  heroImageKey   String?
  contentKey     String
  publishedAt    DateTime?
  authorId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

enum StudyItemKind {
  TASK
  EVENT
}

model Subject {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  order       Int       @default(0)
  studyGoal   StudyGoal @default(UPSC)
  createdAt   DateTime  @default(now())

  topics Topic[]

  @@index([studyGoal])
}

model Topic {
  id          String   @id @default(uuid())
  subjectId   String
  title       String
  slug        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject  Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  articles Article[]

  @@unique([subjectId, slug])
}

model Article {
  id             String        @id @default(uuid())
  topicId        String
  title          String
  slug           String
  contentUrl     String?
  order          Int           @default(0)
  status         ContentStatus @default(DRAFT)
  isPremium      Boolean       @default(false)
  previewPercent Int           @default(30)
  pdfKey         String?
  /** Official source URL when ingested or manually linked. */
  sourceUrl      String?
  /** Copyright tier for embed + save-to-library policy. */
  sourceLicense  IngestLicense?
  /** Short public description for SEO and Learn browse. */
  summary        String?          @db.VarChar(500)
  /** Edition label, e.g. 2025 or 2025-03. */
  edition        String?
  linkStatus     IngestLinkStatus @default(UNKNOWN)
  embeddable     Boolean?
  lastHttpStatus Int?
  lastLinkCheckAt DateTime?
  /** Final URL after redirects on last HTTP check. */
  sourceUrlChecked String?
  lastUrlRepairAt  DateTime?
  archivedAt     DateTime?
  supersededById String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  topic        Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  highlights   Highlight[]
  progress     UserProgress[]
  starred      StarredArticle[]
  studyTasks   StudyTask[]
  ingestItem   IngestItem?
  supersededBy Article?         @relation("ArticleSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   Article[]        @relation("ArticleSupersession")

  @@unique([topicId, slug])
  @@index([status, edition])
  @@index([linkStatus, lastLinkCheckAt])
}

model IngestSource {
  id                   String               @id @default(uuid())
  name                 String
  slug                 String               @unique
  kind                 IngestSourceKind
  feedUrl              String
  studyGoals           StudyGoal[]
  license              IngestLicense
  cadence              IngestRefreshCadence
  enabled              Boolean              @default(true)
  maxItemsPerRun       Int                  @default(20)
  promoteToSubjectSlug String?
  promoteToTopicSlug   String?
  lastPolledAt         DateTime?
  lastSuccessAt        DateTime?
  lastError            String?
  config               Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  items IngestItem[]
  jobs  IngestJob[]

  @@index([enabled, cadence])
}

model IngestItem {
  id                 String           @id @default(uuid())
  sourceId           String
  externalId         String?
  slug               String           @unique
  title              String
  canonicalUrl       String
  publishedAt        DateTime?
  fetchedAt          DateTime         @default(now())
  contentHash        String
  status             IngestItemStatus @default(FETCHED)
  license            IngestLicense
  shelfSummary       String?          @db.Text
  factualExcerpt     String?          @db.VarChar(500)
  fullDocumentStored Boolean          @default(false)
  studyGoals         StudyGoal[]
  tags               String[]
  edition            String?
  sourcePdfUrl       String?
  pdfKey             String?
  articleId          String?          @unique
  supersededById     String?          @unique
  validUntil         DateTime?
  linkStatus         IngestLinkStatus @default(UNKNOWN)
  embeddable         Boolean?
  lastHttpStatus     Int?
  lastLinkCheckAt    DateTime?
  reviewedAt         DateTime?
  publishedAtShelf   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  source       IngestSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  article      Article?     @relation(fields: [articleId], references: [id], onDelete: SetNull)
  supersededBy IngestItem?  @relation("IngestSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   IngestItem?  @relation("IngestSupersession")
  jobs         IngestJob[]

  @@unique([sourceId, contentHash])
  @@index([status, publishedAt])
  @@index([publishedAtShelf])
}

model IngestJob {
  id           String           @id @default(uuid())
  sourceId     String?
  itemId       String?
  phase        IngestJobPhase
  status       IngestJobStatus  @default(QUEUED)
  sqsMessageId String?
  payload      Json?
  error        String?
  attempts     Int              @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())

  source IngestSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  item   IngestItem?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([phase, status, createdAt])
}

/// One admin-triggered content generation run (starter pack or news batch).
model ContentGenJob {
  id             String           @id @default(uuid())
  kind           ContentGenKind
  status         ContentGenStatus @default(QUEUED)
  studyGoal      StudyGoal
  /// Provider label + model actually used, e.g. "sarvam/sarvam-105b".
  model          String
  /// Dry runs generate + score content without writing Articles.
  dryRun         Boolean          @default(false)
  /// When false, pages are text-only (no diagram or at-a-glance figure).
  withIllustrations Boolean       @default(true)
  plannedCount   Int              @default(0)
  completedCount Int              @default(0)
  failedCount    Int              @default(0)
  skippedCount   Int              @default(0)
  inputTokens    Int              @default(0)
  outputTokens   Int              @default(0)
  /// Estimated spend in paise (1 INR = 100 paise).
  costPaise      Int              @default(0)
  requestedById  String?
  error          String?
  /// Set when the provider went down mid-run; the watcher resumes from here.
  pausedReason   String?
  pausedAt       DateTime?
  resumeAttempts Int              @default(0)
  /// Compact run plan (slug list or news clusters). Cleared when the job finishes.
  plan           Json?
  /// Next index into `plan` after a pause or restart. Item rows are created lazily.
  cursor         Int              @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items ContentGenItem[]

  @@index([kind, createdAt])
  @@index([status, createdAt])
}

/// One generated article inside a ContentGenJob.
model ContentGenItem {
  id             String           @id @default(uuid())
  jobId          String
  title          String
  slug           String
  subjectSlug    String
  topicSlug      String
  status         ContentGenStatus @default(QUEUED)
  /// 0-100 relevance score from the recheck pass.
  relevanceScore Int?
  reviewNotes    String?          @db.Text
  /// Legacy news-cluster payload; new jobs keep clusters on ContentGenJob.plan.
  payload        Json?
  articleId      String?
  wordCount      Int              @default(0)
  inputTokens    Int              @default(0)
  outputTokens   Int              @default(0)
  error          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  job ContentGenJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
}

/// One candidate study page, expanded from an official syllabus unit and
/// curated by an admin before any tokens are spent generating it.
model SyllabusTopic {
  id          String    @id @default(uuid())
  studyGoal   StudyGoal
  /// Where the page lands in Learn.
  subjectSlug String
  subjectName String
  paper       String?
  topicSlug   String
  topicTitle  String
  slug        String
  title       String
  /// Verbatim syllabus line this page serves.
  syllabusAnchor String @db.Text
  /// Which syllabus unit produced it, e.g. "upsc:gs3:economy-planning".
  unitKey     String
  /// 1 = high-yield core, 2 = full syllabus, 3 = deep sub-topic.
  priority    Int       @default(2)
  /// Sort position within its topic.
  order       Int       @default(0)

  status TopicCurationStatus @default(PROPOSED)
  /// Synthesised blueprint: mustCover, worked, traps, keywords, diagram kind.
  spec       Json?
  specModel  String?
  /// Shared key so one page can serve several goals with the same syllabus.
  canonicalKey String?

  articleId    String?
  generatedAt  DateTime?
  reviewNotes  String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studyGoal, slug])
  @@index([studyGoal, status, priority])
  @@index([subjectSlug, topicSlug])
  @@index([canonicalKey])
  @@index([unitKey])
}

/// An official document indexed into the admin grounding corpus.
model CorpusDocument {
  id     String @id @default(uuid())
  /// Stable key: ingest item id, article id or source URL hash.
  sourceKey  String @unique
  title      String
  sourceName String
  canonicalUrl String?
  studyGoals StudyGoal[]
  subjectSlug String?
  chunkCount Int      @default(0)
  tokenCount Int      @default(0)
  indexedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sourceName])
  @@index([subjectSlug])
}

enum ContentStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  FAILED
  ARCHIVED
}

enum IngestSourceKind {
  RSS
  OFFICIAL_PDF_WATCH
  OFFICIAL_PAGE_WATCH
}

enum IngestLicense {
  GOVERNMENT_PRESS
  LINK_ONLY
  OFFICIAL_DOCUMENT
}

enum IngestRefreshCadence {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum IngestItemStatus {
  FETCHED
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
  SUPERSEDED
}

enum IngestLinkStatus {
  OK
  BROKEN
  BLOCKED_EMBED
  UNKNOWN
}

enum IngestJobPhase {
  POLL
  FETCH
  PROCESS
  PROMOTE
  ARCHIVE
}

enum IngestJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ContentGenKind {
  STARTER_PACK
  NEWS_BRIEF
  /// Re-process published pages to add CC photos / figures (separate from text generation).
  VISUAL_ENRICH
  /// Expands official syllabus units into candidate page topics.
  TOPIC_EXPANSION
  /// Writes the generation blueprint for each approved topic.
  SPEC_SYNTHESIS
  /// Generates pages from approved, spec'd topics.
  CORPUS_PAGE
}

enum TopicCurationStatus {
  PROPOSED
  APPROVED
  REJECTED
  GENERATED
}

enum ContentGenStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  SKIPPED
}

enum PdfViewMode {
  PARSED
  ORIGINAL
}

enum UserContentType {
  PDF
  HTML
  MARKDOWN
  TEXT
  DOCX
  LINK
  VIDEO
}

enum HighlightKind {
  TEXT
  REGION
}

model Highlight {
  id          String   @id @default(uuid())
  userId      String
  articleId   String
  text        String   @db.Text
  startOffset Int
  endOffset   Int
  color       String   @default("yellow")
  note        String?
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([userId, articleId])
}

model UserProgress {
  id          String    @id @default(uuid())
  userId      String
  articleId   String
  completed   Boolean   @default(false)
  readPercent Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
}

model StarredArticle {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
}

model StudyTask {
  id          String        @id @default(uuid())
  userId      String
  title       String
  notes       String?       @db.Text
  kind        StudyItemKind @default(TASK)
  dueAt       DateTime?
  endsAt      DateTime?
  completed   Boolean       @default(false)
  articleId   String?
  href        String?
  recurrence  String        @default("NONE")
  recurUntil  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([userId, dueAt])
}

model Payment {
  id                String            @id @default(uuid())
  userId            String
  provider          String            @default("razorpay")
  providerOrderId   String            @unique
  providerPaymentId String?
  /** Amount charged (paise), after coupon + coins. */
  amount            Int
  /** List price before discounts (paise). */
  listAmount        Int?
  currency          String            @default("INR")
  status            PaymentStatus     @default(PENDING)
  planDays          Int               @default(365)
  billingInterval   BillingInterval   @default(ONCE)
  couponId          String?
  affiliateCode     String?
  coinsApplied      Int               @default(0)
  createdAt         DateTime          @default(now())
  completedAt       DateTime?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon            Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  affiliateEarning  AffiliateEarning?
  couponRedemption  CouponRedemption?

  @@index([userId])
  @@index([couponId])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum BillingInterval {
  ONCE
  MONTHLY
  YEARLY
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id              String     @id @default(uuid())
  code            String     @unique
  type            CouponType
  /** PERCENT: 1–100. FIXED: discount in paise. */
  value           Int
  maxUses         Int?
  maxUsesPerUser  Int        @default(1)
  usedCount       Int        @default(0)
  validFrom       DateTime?
  validUntil      DateTime?
  active          Boolean    @default(true)
  minAmount       Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  payments    Payment[]
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  paymentId String   @unique
  createdAt DateTime @default(now())

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

model AffiliateProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AffiliateEarning {
  id              String   @id @default(uuid())
  affiliateUserId String
  referredUserId  String
  paymentId       String   @unique
  /** Coins credited (paise). */
  amountCoins     Int
  createdAt       DateTime @default(now())

  affiliate User    @relation("AffiliateEarner", fields: [affiliateUserId], references: [id], onDelete: Cascade)
  referred  User    @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([affiliateUserId])
}

enum RecurringStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PAUSED
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
}

model RecurringSubscription {
  id                     String           @id @default(uuid())
  userId                 String
  providerSubscriptionId String           @unique
  providerPlanId         String
  interval               BillingInterval
  status                 RecurringStatus  @default(CREATED)
  amount                 Int
  currency               String           @default("INR")
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean          @default(false)
  couponId               String?
  affiliateCode          String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model UserFolder {
  id          String   @id @default(uuid())
  userId      String
  parentId    String?
  name        String
  slug        String
  description String?
  icon        String   @default("📁")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   UserFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children UserFolder[] @relation("FolderTree")
  files    UserTopic[]

  @@index([userId])
  @@index([parentId])
}

/** @deprecated Legacy collection table — migrated to UserFolder. Do not write. */
model UserSubject {
  id          String   @id @default(uuid())
  userId      String
  name        String
  slug        String
  description String?
  icon        String   @default("📁")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicGroups UserTopicGroup[]
  topics      UserTopic[]

  @@unique([userId, slug])
  @@index([userId])
}

/** @deprecated Legacy topic folder — migrated to UserFolder. Do not write. */
model UserTopicGroup {
  id            String   @id @default(uuid())
  userSubjectId String
  title         String
  slug          String
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userSubject UserSubject @relation(fields: [userSubjectId], references: [id], onDelete: Cascade)
  pages       UserTopic[]

  @@unique([userSubjectId, slug])
  @@index([userSubjectId])
}

model UserTopic {
  id               String           @id @default(uuid())
  userId           String
  /** Primary parent folder (library file). Replaces userSubjectId + userTopicGroupId. */
  folderId         String?
  userSubjectId    String?
  userTopicGroupId String?
  title            String
  slug             String
  contentUrl       String?
  sourceUrl        String?
  pdfKey           String?
  pdfViewMode      PdfViewMode      @default(ORIGINAL)
  contentType      UserContentType  @default(HTML)
  fileSizeBytes    Int              @default(0)
  status           ContentStatus    @default(DRAFT)
  order            Int              @default(0)
  completed        Boolean          @default(false)
  readPercent      Int              @default(0)
  starred          Boolean          @default(false)
  completedAt      DateTime?
  /** Last PDF page (1-based) or HTML scroll — synced across devices. */
  viewPdfPage      Int?
  viewPageOffset   Float?
  viewScrollTop    Int?
  viewScale        Float?
  viewedAt         DateTime?
  /** Anyone with the link (signed-in) may view when set with linkShareToken. */
  linkShareEnabled Boolean          @default(false)
  linkShareToken   String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder         UserFolder?             @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userSubject    UserSubject?            @relation(fields: [userSubjectId], references: [id], onDelete: Cascade)
  userTopicGroup UserTopicGroup?         @relation(fields: [userTopicGroupId], references: [id], onDelete: Cascade)
  highlights     UserContentHighlight[]
  vectorIndex    PageVectorIndex?
  shares         PageShare[]

  // Slug uniqueness: partial indexes in migration (root / notebook / topic).
  @@index([userId])
  @@index([folderId])
  @@index([userSubjectId])
  @@index([userTopicGroupId])
  @@index([userId, viewedAt])
}

enum PageShareRole {
  VIEWER
  EDITOR
}

enum PageShareStatus {
  PENDING
  ACTIVE
  REVOKED
}

model PageShare {
  id           String          @id @default(uuid())
  pageId       String
  ownerId      String
  granteeId    String?
  granteeEmail String
  role         PageShareRole   @default(VIEWER)
  status       PageShareStatus @default(PENDING)
  /** Recipient hid the row from Shared with me (access unchanged until revoked). */
  hiddenAt     DateTime?
  seenAt       DateTime?
  /** Independent copy in the recipient's library, if they saved one. */
  copiedPageId String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  page    UserTopic @relation(fields: [pageId], references: [id], onDelete: Cascade)
  owner   User      @relation("PageShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  grantee User?     @relation("PageShareGrantee", fields: [granteeId], references: [id], onDelete: SetNull)

  @@unique([pageId, granteeEmail])
  @@index([granteeId, status])
  @@index([granteeEmail, status])
  @@index([pageId, status])
  @@index([ownerId])
}

model UserContentHighlight {
  id          String        @id @default(uuid())
  userId      String
  userTopicId String
  text        String        @db.Text
  startOffset Int           @default(0)
  endOffset   Int           @default(0)
  color       String        @default("yellow")
  note        String?
  kind        HighlightKind @default(TEXT)
  pageNumber  Int?
  position    Json?
  createdAt   DateTime      @default(now())

  userTopic UserTopic @relation(fields: [userTopicId], references: [id], onDelete: Cascade)

  @@index([userId, userTopicId])
}

model PageVectorIndex {
  pageId      String   @id
  userId      String
  chunkCount  Int
  contentHash String
  indexedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  page UserTopic @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([userId, indexedAt])
}

model StudyRelevancyDoc {
  id               String   @id @default(uuid())
  userId           String
  title            String
  body             String   @db.Text
  source           String
  originalFilename String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  threads ChatThread[]
  quizzes Quiz[]

  @@index([userId, updatedAt])
}

model ChatThread {
  id                 String   @id @default(uuid())
  userId             String
  title              String   @default("New chat")
  contextKind        String   @default("LIBRARY")
  contextNotebookId  String?
  contextTopicId     String?
  contextFolderId    String?
  contextPageId      String?
  relevancyDocId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  relevancyDoc StudyRelevancyDoc?  @relation(fields: [relevancyDocId], references: [id], onDelete: SetNull)
  messages     ChatMessage[]

  @@index([userId, updatedAt])
  @@index([relevancyDocId])
}

model ChatMessage {
  id         String   @id @default(uuid())
  threadId   String
  role       String
  content    String   @db.Text
  citations  Json?
  createdAt  DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

enum QuizSourceKind {
  LIBRARY
  UPLOAD
  EXAM_BANK
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
  EXAM
}

enum QuizQuestionType {
  MCQ
  WRITTEN
  IMAGE
}

enum QuizStatus {
  GENERATING
  READY
  IN_PROGRESS
  SUBMITTED
  GRADED
  FAILED
}

model Quiz {
  id                String         @id @default(uuid())
  userId            String
  title             String         @default("Quiz")
  sourceKind        QuizSourceKind
  contextKind       String         @default("LIBRARY")
  contextNotebookId String?
  contextTopicId    String?
  contextFolderId   String?
  contextPageId     String?
  relevancyDocId    String?
  sourceLabel       String?
  focusTopic        String?
  sourceExcerpt     String?        @db.Text
  difficulty        QuizDifficulty @default(EXAM)
  timeLimitSec      Int?
  mcqCount          Int            @default(5)
  writtenCount      Int            @default(2)
  proctored         Boolean        @default(true)
  endedReason       String?
  status            QuizStatus     @default(GENERATING)
  startedAt         DateTime?
  submittedAt       DateTime?
  errorMessage      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  relevancyDoc StudyRelevancyDoc? @relation(fields: [relevancyDocId], references: [id], onDelete: SetNull)
  questions    QuizQuestion[]

  @@index([userId, updatedAt])
  @@index([relevancyDocId])
}

model QuizQuestion {
  id                String           @id @default(uuid())
  quizId            String
  order             Int
  type              QuizQuestionType
  prompt            String           @db.Text
  options           Json?
  correctOptionId   String?
  modelAnswer       String?          @db.Text
  explanation       String?          @db.Text
  marks             Int              @default(1)
  syllabusHeading   String?
  sourceTag         String?
  userAnswerText    String?          @db.Text
  userAnswerOption  String?
  userImageKey      String?
  userImageMime     String?
  gradedScore       Float?
  gradedFeedback    String?          @db.Text
  createdAt         DateTime         @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, order])
}

