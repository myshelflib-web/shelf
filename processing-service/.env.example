PORT=4001
BACKEND_URL="http://localhost:4000"
INTERNAL_SECRET="change-me-internal-secret"
POLL_INTERVAL_MS=15000
# Always one PDF at a time (hard-capped).
# PROCESS_JOBS_PER_POLL=1

# Observability — debug | info | warn | error
LOG_LEVEL="info"
SERVICE_NAME="processing-service"

# Grafana (OpenTelemetry OTLP) — traces, metrics, and application logs. Leave unset to disable.
# Same endpoint/headers as backend; different service name.
# OTEL_SERVICE_NAME="shelf-processing-service"
# OTEL_DEPLOYMENT_ENVIRONMENT="production"
# OTEL_EXPORTER_OTLP_ENDPOINT="https://otlp-gateway-prod-REGION.grafana.net/otlp"
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic%20BASE64(instanceId:token)"
# Local (no auth): OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# --- Local dev (MinIO) ---
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="upsc-docs"
S3_REGION="us-east-1"

# --- Production (Cloudflare R2) — same values as backend on Render ---
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY="<32-char R2 Access Key ID>"
# S3_SECRET_KEY="<64-char R2 Secret Access Key>"
# S3_BUCKET="upsc-docs"
# S3_REGION="auto"
