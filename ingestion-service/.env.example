PORT=4002
BACKEND_URL="http://localhost:4000"
INTERNAL_SECRET="change-me-internal-secret"
LOG_LEVEL="info"
# INGEST_LOG_LEVEL="debug"
SERVICE_NAME="ingestion-service"

# Worker mode: sqs (production) | poll (local fallback — polls backend due-sources)
INGEST_WORKER_MODE="sqs"

# AWS SQS — create five standard queues (or .fifo) and paste URLs here.
AWS_REGION="ap-south-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

INGEST_SQS_POLL_QUEUE_URL=""
INGEST_SQS_FETCH_QUEUE_URL=""
INGEST_SQS_PROCESS_QUEUE_URL=""
INGEST_SQS_PROMOTE_QUEUE_URL=""
INGEST_SQS_ARCHIVE_QUEUE_URL=""

# Long-poll wait (seconds, max 20)
INGEST_SQS_WAIT_SECONDS="20"
# Visibility timeout (seconds)
INGEST_SQS_VISIBILITY_TIMEOUT="300"

# Local poll fallback interval when mode=poll or queues unset
INGEST_POLL_INTERVAL_MS="60000"
